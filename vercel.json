{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash ./vercel-build-test.sh",
  "outputDirectory": "dist-test",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/agcb-drive-bridge",
      "destination": "https://script.google.com/macros/s/AKfycbx2kSQg7qx4b5MIRGnc-aPL0vjAXw8Fdbc3whvVf72KooBxmGUesF-pLBaMLopgE8gA/exec"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-AGCB-Environment", "value": "TEST" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
