{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bash ./vercel-build-test.sh",
  "outputDirectory": "dist-test",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-AGCB-Environment", "value": "TEST" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
